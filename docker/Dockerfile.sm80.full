# syntax=docker/dockerfile:1.6
#
# Mint full image for A800 / SM80 — NOT RECOMMENDED.
#
# All dependencies baked in: torch 2.11.0+cu130, vLLM 0.23.0, DeepEP, ray, …
# Any dependency update requires a full image rebuild (20+ min).
# Use docker/Dockerfile.sm80.overlay instead.
#
# Build:
#   docker build -t mint:full-sm80 \
#     --build-arg DEEPEP_VARIANT=sm80 \
#     -f docker/Dockerfile.sm80.full .
#
# DeepEP variants:
#   sm80 — rebuild with DISABLE_SM90_FEATURES=1, force-disable NVSHMEM (A800)
#   base — use DeepEP as-is (SM90 only, will crash on A800)

ARG CUDA_IMAGE=nvidia/cuda:13.0.3-cudnn-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive

# ─── System deps + Python 3.13 (deadsnakes PPA) ─────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
  aria2 \
  ca-certificates \
  curl \
  wget \
  git \
  git-lfs \
  openssh-client \
  openssh-server \
  rsync \
  build-essential \
  ninja-build \
  software-properties-common \
  ibverbs-providers \
  ibverbs-utils \
  libibverbs-dev \
  numactl \
  iotop \
  sysstat \
  vim \
  less \
  strace \
  gdb \
  htop \
  && add-apt-repository -y ppa:deadsnakes/ppa \
  && apt-get update && apt-get install -y --no-install-recommends \
  python3.13 \
  python3.13-venv \
  python3.13-dev \
  && ln -sf /usr/bin/python3.13 /usr/local/bin/python3 \
  && ln -sf /usr/bin/python3.13 /usr/local/bin/python \
  && rm -rf /var/lib/apt/lists/*

# ─── SSH (for Ray inter-node communication & debugging) ─────────────
RUN mkdir -p /run/sshd && \
    ssh-keygen -A && \
    sed -i \
      -e 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' \
      -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' \
      /etc/ssh/sshd_config

# ─── Virtualenv ─────────────────────────────────────────────────────
ENV VIRTUAL_ENV=/opt/venv
RUN python -m venv --system-site-packages "${VIRTUAL_ENV}"
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

ARG PIP_VERSION=26.1.2
ARG SETUPTOOLS_VERSION=82.0.1
RUN python -m ensurepip --upgrade \
  && python -m pip install --no-cache-dir --break-system-packages --upgrade \
  "pip==${PIP_VERSION}" \
  "setuptools==${SETUPTOOLS_VERSION}" \
  wheel

ARG PIP_INDEX_URL=https://mirrors.ivolces.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# ─── Environment ───────────────────────────────────────────────────
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:${LD_LIBRARY_PATH}"
ENV CUDA_HOME="/usr/local/cuda"
ENV NCCL_IB_DISABLE=0
ENV NCCL_NET_GDR_LEVEL=2
ENV NCCL_DEBUG=WARN
ENV PFS_OVERLAY_ROOT=/vePFS-Mindverse
ENV PFS_RUNTIME_ENV_ROOT=${PFS_OVERLAY_ROOT}/runtime-env
ENV PFS_HF_MODULES_PATH=${PFS_OVERLAY_ROOT}/hf-modules

# ─── torch (CUDA 13.0 from cu130 index) ────────────────────────────
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu130
ARG TORCH_VERSION=2.11.0
RUN python -m pip install --no-cache-dir \
    --index-url "${TORCH_INDEX}" \
    --extra-index-url https://pypi.org/simple \
    "torch==${TORCH_VERSION}" \
    "torchvision==0.26.0" \
    "torchaudio==2.11.0"

# ─── vLLM ───────────────────────────────────────────────────────────
ARG VLLM_VERSION=0.23.0
RUN python -m pip install --no-cache-dir \
    "vllm==${VLLM_VERSION}"

# ─── Core runtime deps ─────────────────────────────────────────────
RUN python -m pip install --no-cache-dir --only-binary=:all: \
    "ray[default,cpp]==2.51.1" \
    "fastapi[standard]==0.138.0" \
    "uvicorn[standard]==0.49.0" \
    "pydantic==2.13.4" \
    "httpx==0.28.1" \
    "structlog==26.1.0" \
    "opentelemetry-api==1.42.1" \
    "opentelemetry-sdk==1.42.1" \
    "opentelemetry-exporter-otlp==1.42.1" \
    "transformers==5.5.4" \
    "accelerate==1.14.0" \
    "einops" \
    "onnxscript" \
    "codetiming==1.4.0" \
    "torchdata==0.11.0" \
    "datasets==5.0.0" \
    "tensordict" \
    "peft==0.19.1"

# ─── NVIDIA ModelOpt ───────────────────────────────────────────────
ARG NVIDIA_PYPI_INDEX=https://pypi.nvidia.com
ARG NVIDIA_MODELOPT_VERSION=0.44.0
RUN python -m pip install --no-cache-dir \
  --index-url "${NVIDIA_PYPI_INDEX}" \
  --extra-index-url https://pypi.org/simple \
  --retries 10 --timeout 60 \
  --only-binary=:all: \
  "nvidia-modelopt==${NVIDIA_MODELOPT_VERSION}"

# ─── Misc build deps ──────────────────────────────────────────────
RUN python -m pip install --no-cache-dir --only-binary=:all: --retries 10 --timeout 60 "pybind11==2.9.2"

# OmegaConf requires antlr4-python3-runtime==4.9.*
RUN python -m pip install --no-cache-dir --only-binary=:all: --no-deps "omegaconf==2.3.1" \
  && python -m pip install --no-cache-dir --no-build-isolation "antlr4-python3-runtime==4.9.3" \
  && python -c "import antlr4; print('antlr4 OK'); import omegaconf; print('omegaconf:', omegaconf.__version__)"

# ─── DeepEP build from source (last — slowest, most volatile) ──────
# Placed after all pip deps so that changing a runtime dep version
# does NOT trigger a DeepEP rebuild.
ARG DEEPEP_VARIANT=sm80
ARG DEEPEP_REPO=https://github.com/deepseek-ai/DeepEP
ARG DEEPEP_BRANCH=main
RUN set -euo pipefail; \
  git clone --depth 1 -b "${DEEPEP_BRANCH}" "${DEEPEP_REPO}" /tmp/DeepEP; \
  if [ "${DEEPEP_VARIANT}" = "base" ]; then \
    echo "DeepEP variant: base (SM90, not patched)"; \
    TORCH_CUDA_ARCH_LIST=9.0 python -m pip install --no-cache-dir --no-deps --no-build-isolation /tmp/DeepEP; \
    python -c "import deep_ep_cpp; assert deep_ep_cpp.is_sm90_compiled() is True; print('deep_ep_cpp SM90 OK')"; \
  elif [ "${DEEPEP_VARIANT}" = "sm80" ]; then \
    echo "DeepEP variant: sm80"; \
    python -c $'from __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nsetup_py = Path("/tmp/DeepEP/setup.py")\nif not setup_py.exists():\n    raise SystemExit(f"DeepEP setup.py not found at {setup_py}")\nsetup_txt = setup_py.read_text(encoding="utf-8")\n\nif "Patched: force-disable NVSHMEM" not in setup_txt:\n    lines = setup_py.splitlines(True)\n    insert_at = None\n    for i, line in enumerate(lines):\n        if line.strip() == "# NVSHMEM flags":\n            insert_at = i\n            break\n    if insert_at is None:\n        raise SystemExit("DeepEP setup.py anchor not found: # NVSHMEM flags")\n\n    nl = chr(10)\n    env_key = "DISABLE_SM90_FEATURES"\n    inject_lines = [\n        "    # Patched: force-disable NVSHMEM when DISABLE_SM90_FEATURES=1 (SM80 build)" + nl,\n        f"    if int(os.getenv({env_key!r}, 0)):" + nl,\n        "        disable_nvshmem = True" + nl,\n        nl,\n    ]\n    lines[insert_at:insert_at] = inject_lines\n    setup_py.write_text("".join(lines), encoding="utf-8")\n\ncfg = Path("/tmp/DeepEP/csrc/config.hpp")\nif not cfg.exists():\n    raise SystemExit(f"DeepEP config.hpp not found at {cfg}")\ncfg_txt = cfg.read_text(encoding="utf-8")\n\ncfg_lines = cfg_txt.splitlines(True)\nmatch_idxs = [i for i, line in enumerate(cfg_lines) if "NVSHMEM is disable during compilation" in line]\nif len(match_idxs) != 1:\n    raise SystemExit("DeepEP config.hpp needle not found for NVSHMEM-disabled RDMA hint")\nidx = match_idxs[0]\nindent = cfg_lines[idx][: (len(cfg_lines[idx]) - len(cfg_lines[idx].lstrip()))]\ncfg_lines[idx] = indent + "return 0;" + chr(10)\ncfg.write_text("".join(cfg_lines), encoding="utf-8")\n'; \
    DISABLE_SM90_FEATURES=1 TORCH_CUDA_ARCH_LIST=8.0 python -m pip install --no-cache-dir --no-deps --no-build-isolation /tmp/DeepEP; \
    python -c "import deep_ep_cpp; assert deep_ep_cpp.is_sm90_compiled() is False; print('deep_ep_cpp SM80 OK')"; \
  else \
    echo "ERROR: unknown DEEPEP_VARIANT='${DEEPEP_VARIANT}'" >&2; exit 1; \
  fi; \
  rm -rf /tmp/DeepEP

# ─── Verification ──────────────────────────────────────────────────
RUN python -c "import torch; print('torch:', torch.__version__); print('cuda:', torch.version.cuda); assert (torch.version.cuda or '').startswith('13.')" \
 && python -c "import vllm; print('vllm:', getattr(vllm, '__version__', 'unknown'))" \
 && python -c "import onnxscript, modelopt; print('onnxscript OK'); print('modelopt:', getattr(modelopt, '__version__', 'unknown'))" \
 && python -c "import ray; print('ray:', ray.__version__)" \
 && python -c "import deep_ep_cpp; print('deep_ep sm90:', deep_ep_cpp.is_sm90_compiled())"

CMD ["bash", "-lc", "python -c 'import torch, deep_ep_cpp, vllm; print(torch.__version__, torch.version.cuda); print(getattr(vllm, \"__version__\", \"unknown\"))' && sleep infinity"]
