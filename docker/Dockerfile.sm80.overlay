# syntax=docker/dockerfile:1.6
#
# Mint overlay image for A800 / SM80 — RECOMMENDED.
#
# CUDA + system tools + Python 3.13 + Ray in the image.
# torch/vLLM/DeepEP/Megatron/verl come from the PFS overlay disk at runtime.
#
# Why Ray in the image: Ray must be available at container start to form
# the cluster. Heavy ML packages (torch, vLLM, DeepEP) load from PFS via
# PYTHONPATH injection at Ray worker launch time.
#
# Build:
#   docker build -t mint:overlay-sm80 -f docker/Dockerfile.sm80.overlay .

ARG CUDA_IMAGE=nvidia/cuda:13.0.3-cudnn-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive

# ─── System deps + Python 3.13 (deadsnakes PPA) ─────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
  aria2 \
  ca-certificates \
  curl \
  wget \
  git \
  git-lfs \
  openssh-client \
  openssh-server \
  rsync \
  build-essential \
  ninja-build \
  software-properties-common \
  ibverbs-providers \
  ibverbs-utils \
  libibverbs-dev \
  numactl \
  iotop \
  sysstat \
  vim \
  less \
  strace \
  gdb \
  htop \
  && add-apt-repository -y ppa:deadsnakes/ppa \
  && apt-get update && apt-get install -y --no-install-recommends \
  python3.13 \
  python3.13-venv \
  python3.13-dev \
  && ln -sf /usr/bin/python3.13 /usr/local/bin/python3 \
  && ln -sf /usr/bin/python3.13 /usr/local/bin/python \
  && rm -rf /var/lib/apt/lists/*

# ─── SSH (for Ray inter-node communication & debugging) ─────────────
RUN mkdir -p /run/sshd && \
    ssh-keygen -A && \
    sed -i \
      -e 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' \
      -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' \
      /etc/ssh/sshd_config

# ─── pip + Ray (system Python, no venv) ────────────────────────────
ARG PIP_VERSION=26.1.2
ARG SETUPTOOLS_VERSION=82.0.1
RUN python -m ensurepip --upgrade \
  && python -m pip install --no-cache-dir --break-system-packages --upgrade \
  "pip==${PIP_VERSION}" \
  "setuptools==${SETUPTOOLS_VERSION}" \
  wheel

ARG RAY_VERSION=2.51.1
ARG PIP_INDEX_URL=https://mirrors.ivolces.com/pypi/simple/
RUN python -m pip install --no-cache-dir --break-system-packages --only-binary=:all: \
  --index-url "${PIP_INDEX_URL}" \
  --retries 10 --timeout 120 \
  "ray[default,cpp]==${RAY_VERSION}"

# ─── Environment ───────────────────────────────────────────────────
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:${LD_LIBRARY_PATH}"
ENV CUDA_HOME="/usr/local/cuda"
ENV NCCL_IB_DISABLE=0
ENV NCCL_NET_GDR_LEVEL=2
ENV NCCL_DEBUG=WARN
ENV PFS_OVERLAY_ROOT=/vePFS-Mindverse
ENV PFS_RUNTIME_ENV_ROOT=${PFS_OVERLAY_ROOT}/runtime-env
ENV PFS_HF_MODULES_PATH=${PFS_OVERLAY_ROOT}/hf-modules

# ─── Verify ────────────────────────────────────────────────────────
RUN python -c "import ray; print('ray:', ray.__version__); print('python:', __import__('sys').version)"

CMD ["bash", "-lc", "sleep infinity"]
