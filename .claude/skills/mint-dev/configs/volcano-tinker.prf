# Unison profile: bidirectional sync between local and PFS
# Install: cp volcano-tinker.prf ~/.unison/
# Usage: unison volcano-tinker -repeat watch
#
# For concurrent dev runs (Issue #83): copy this profile and change the PFS root
# to a per-developer path (example: /vePFS-Mindverse/share/code/$USER/tinker-server).
#
# PFS is single source of truth. Edit on either local machine or server.
# Unison keeps both in sync, preferring newer changes.

root = /home/yiwen/tinker_project/tinker-server
root = ssh://volcano//vePFS-Mindverse/share/code/tinker-server

# Sync options
auto = true
batch = true
prefer = newer
times = true

# Ignore patterns (only temp/build artifacts)
ignore = Name {*.pyc}
ignore = Name {__pycache__}
ignore = Name {*.swp}
ignore = Name {*.swo}
ignore = Name {.DS_Store}
ignore = Name {node_modules}
ignore = Name {.venv}
ignore = Name {venv}
ignore = Name {.mypy_cache}
ignore = Name {.pytest_cache}
ignore = Name {*.egg-info}

# SSH options - use the compiled unison on remote
servercmd = /usr/local/bin/unison
