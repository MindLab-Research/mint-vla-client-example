# Unison profile: bidirectional sync between local and PFS
# Template: generate a per-user profile (no shared PFS root)
# Install:
#   mkdir -p ~/.unison
#   sed "s/__PFS_USER__/$USER/g" volcano-tinker.prf > ~/.unison/volcano-tinker-$USER.prf
# Usage (persistent; systemd --user):
#   mkdir -p ~/.config/systemd/user
#   cat > ~/.config/systemd/user/unison@.service <<'EOF'
#   [Unit]
#   Description=Unison (%i) watch
#   [Service]
#   Type=simple
#   ExecStart=/usr/bin/unison %i -repeat watch -ui text
#   Restart=always
#   RestartSec=2
#   StandardOutput=append:/tmp/unison-%i.log
#   StandardError=append:/tmp/unison-%i.log
#   [Install]
#   WantedBy=default.target
#   EOF
#   systemctl --user daemon-reload
#   loginctl enable-linger "$USER" || true
#   systemctl --user enable --now "unison@volcano-tinker-$USER.service"
#
# Remote root must be per-user: /vePFS-Mindverse/share/code/<user>/tinker-server
#
# PFS is single source of truth. Edit on either local machine or server.
# Unison keeps both in sync, preferring newer changes.

root = /home/yiwen/tinker_project/tinker-server
root = ssh://volcano//vePFS-Mindverse/share/code/__PFS_USER__/tinker-server

# Sync options
auto = true
batch = true
prefer = newer
times = true

# Ignore patterns (only temp/build artifacts)
ignore = Name {*.pyc}
ignore = Name {__pycache__}
ignore = Name {*.swp}
ignore = Name {*.swo}
ignore = Name {.DS_Store}
ignore = Name {node_modules}
ignore = Name {.venv}
ignore = Name {venv}
ignore = Name {.mypy_cache}
ignore = Name {.pytest_cache}
ignore = Name {*.egg-info}

# SSH options - use the compiled unison on remote
servercmd = /usr/local/bin/unison
