# Unison profile for syncing tinker_project with volcano
# Install to: ~/.unison/volcano-tinker.prf
# Run with: unison volcano-tinker -repeat watch

root = /home/yiwen/tinker_project
root = ssh://volcano//root/tinker_project

# Sync options
auto = true
batch = true
prefer = newer
times = true

# Ignore common patterns
ignore = Name {*.pyc}
ignore = Name {__pycache__}
ignore = Name {.git}
ignore = Name {*.swp}
ignore = Name {*.swo}
ignore = Name {.DS_Store}
ignore = Name {node_modules}
ignore = Name {.venv}
ignore = Name {venv}

# SSH options - use the compiled unison on remote
servercmd = /usr/local/bin/unison
