#!/usr/bin/env python3
import json
import os
import socket
import sys
import time
from pathlib import Path

import ray
from ray._private.node import Node
from ray._private.parameter import RayParams


CHECK_INTERVAL_S = 10
DEFAULT_MIN_TMP_FREE_BYTES = 50 * 1024 * 1024 * 1024


def _int_env(name: str, default: int) -> int:
    value = os.environ.get(name)
    if value is None or not value.strip():
        return default
    try:
        return int(value)
    except ValueError:
        print(f"mint ray ignoring invalid integer env {name}={value!r}; using default={default}", flush=True)
        return default


def _port_open(address: str) -> bool:
    host, port_s = address.rsplit(":", 1)
    sock = socket.socket()
    sock.settimeout(2)
    try:
        sock.connect((host, int(port_s)))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def _write_text_atomic(path: str, text: str) -> None:
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, target)


def _read_head(head_ip_path: str) -> str:
    while True:
        try:
            ip = Path(head_ip_path).read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            ip = ""
        if not ip:
            print(f"mint ray worker waiting for head IP file: {head_ip_path}", flush=True)
            time.sleep(5)
            continue
        head = f"{ip}:6379"
        if _port_open(head):
            return head
        print(f"mint ray worker sees head file {head}, but gcs port is not reachable yet", flush=True)
        time.sleep(5)


def _mountinfo_unescape(value: str) -> str:
    out = value
    for escaped, char in (("\\040", " "), ("\\011", "\t"), ("\\012", "\n"), ("\\134", "\\")):
        out = out.replace(escaped, char)
    return out


def _read_mountinfo(path: str = "/proc/self/mountinfo") -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except OSError:
        return entries
    for line in lines:
        if " - " not in line:
            continue
        before, after = line.split(" - ", 1)
        before_parts = before.split()
        after_parts = after.split()
        if len(before_parts) < 5 or len(after_parts) < 2:
            continue
        entries.append(
            {
                "mount_point": _mountinfo_unescape(before_parts[4]),
                "fs_type": _mountinfo_unescape(after_parts[0]),
                "mount_source": _mountinfo_unescape(after_parts[1]),
            }
        )
    return entries


def _mount_for_path(path: Path, entries: list[dict[str, str]]) -> dict[str, str] | None:
    path_text = str(path)
    best: dict[str, str] | None = None
    best_len = -1
    for entry in entries:
        mount_point = entry.get("mount_point") or ""
        if not mount_point:
            continue
        if path_text == mount_point or path_text.startswith(mount_point.rstrip("/") + "/"):
            if len(mount_point) > best_len:
                best = entry
                best_len = len(mount_point)
    return best


def _path_is_writable(path: Path) -> bool:
    probe = path / f".mint-ray-node-write-check-{os.getpid()}"
    try:
        probe.write_text("ok", encoding="utf-8")
        probe.unlink()
        return True
    except OSError:
        try:
            probe.unlink()
        except OSError:
            pass
        return False


def _path_diagnostic(
    *,
    role: str,
    node_id: str,
    kind: str,
    path: str,
    min_free_bytes: int,
    mountinfo: list[dict[str, str]] | None = None,
) -> dict[str, object]:
    configured = Path(path)
    resolved = configured.resolve(strict=False)
    exists = configured.exists()
    writable = _path_is_writable(configured) if exists and configured.is_dir() else False
    stat_path = configured if exists else configured.parent
    free_bytes = None
    total_bytes = None
    try:
        stats = os.statvfs(stat_path)
        free_bytes = int(stats.f_bavail * stats.f_frsize)
        total_bytes = int(stats.f_blocks * stats.f_frsize)
    except OSError:
        pass

    mount = _mount_for_path(resolved, mountinfo if mountinfo is not None else _read_mountinfo())
    warnings: list[str] = []
    if free_bytes is not None and free_bytes < min_free_bytes:
        warnings.append("low_free_space")
    if not exists:
        warnings.append("missing_path")
    elif not writable:
        warnings.append("not_writable")

    record: dict[str, object] = {
        "role": role,
        "node_id": node_id,
        "kind": kind,
        "configured": str(configured),
        "resolved": str(resolved),
        "exists": exists,
        "writable": writable,
        "free_bytes": free_bytes,
        "total_bytes": total_bytes,
        "min_free_bytes": min_free_bytes,
        "warnings": warnings,
    }
    if mount is not None:
        record.update(
            {
                "mount_point": mount.get("mount_point", ""),
                "fs_type": mount.get("fs_type", ""),
                "mount_source": mount.get("mount_source", ""),
            }
        )
    return record


def _log_path_diagnostics(role: str, node_id: str, paths: dict[str, str]) -> None:
    min_free_bytes = _int_env("MINT_RAY_WARN_TMP_FREE_BYTES", DEFAULT_MIN_TMP_FREE_BYTES)
    mountinfo = _read_mountinfo()
    for kind, path in paths.items():
        record = _path_diagnostic(
            role=role,
            node_id=node_id,
            kind=kind,
            path=path,
            min_free_bytes=min_free_bytes,
            mountinfo=mountinfo,
        )
        print(f"mint ray path check {json.dumps(record, sort_keys=True)}", flush=True)


def _prepare_tmp(role: str, node_id: str) -> tuple[str, str, str, str]:
    tmp_root = os.environ.get("MINT_TMP_ROOT", "/mnt/tmp")
    if role == "head":
        base = Path(tmp_root) / "h"
    else:
        base = Path(tmp_root) / "w" / node_id
    temp_dir = base / "t"
    object_spilling_dir = base / "s"
    os_tmpdir = base / "tmp"
    xdg_cache_home = base / "cache"
    for path in (temp_dir, object_spilling_dir, os_tmpdir, xdg_cache_home):
        path.mkdir(parents=True, exist_ok=True)
    os.environ["TMPDIR"] = str(os_tmpdir)
    os.environ["XDG_CACHE_HOME"] = str(xdg_cache_home)
    os.environ.setdefault("RAY_RUNTIME_ENV_WORKING_DIR_CACHE_SIZE_GB", "2")
    os.environ.setdefault("RAY_RUNTIME_ENV_PIP_CACHE_SIZE_GB", "2")
    print(
        "mint ray using "
        f"role={role} temp_dir={temp_dir} object_spilling_directory={object_spilling_dir} "
        f"tmpdir={os_tmpdir} xdg_cache_home={xdg_cache_home}",
        flush=True,
    )
    _log_path_diagnostics(
        role,
        node_id,
        {
            "MINT_TMP_ROOT": str(tmp_root),
            "temp_dir": str(temp_dir),
            "object_spilling_directory": str(object_spilling_dir),
            "TMPDIR": str(os_tmpdir),
            "XDG_CACHE_HOME": str(xdg_cache_home),
        },
    )
    return str(temp_dir), str(object_spilling_dir), str(os_tmpdir), str(xdg_cache_home)


def _env_bool(name: str, default: bool) -> bool:
    value = os.environ.get(name)
    if value is None:
        return default
    value = value.strip().lower()
    if value in {"1", "true", "yes", "on"}:
        return True
    if value in {"0", "false", "no", "off"}:
        return False
    return default


def main() -> int:
    role = os.environ.get("MINT_NODE_ROLE", "").strip()
    if role not in {"head", "worker"}:
        print(f"error: MINT_NODE_ROLE must be head or worker, got {role!r}", file=sys.stderr, flush=True)
        return 2

    ip = ray.util.get_node_ip_address()
    node_id = os.environ.get("MINT_NODE_ID") or ip.replace(".", "-")
    head_ip_path = os.environ["MINT_RAY_HEAD_IP_PATH"]
    temp_dir, object_spilling_dir, _, _ = _prepare_tmp(role, node_id)

    while True:
        node = None
        try:
            if role == "head":
                print(f"mint ray head starting on {ip}", flush=True)
                include_dashboard = _env_bool("MINT_RAY_INCLUDE_DASHBOARD", True)
                ray_client_port = int(os.environ.get("MINT_RAY_CLIENT_SERVER_PORT", "10001") or "0")
                ray_kwargs = {
                    "num_cpus": 4,
                    "num_gpus": 0,
                    "include_dashboard": include_dashboard,
                    "gcs_server_port": 6379,
                    "temp_dir": temp_dir,
                    "object_spilling_directory": object_spilling_dir,
                }
                if include_dashboard:
                    ray_kwargs["dashboard_host"] = "0.0.0.0"
                    ray_kwargs["dashboard_port"] = 8265
                if ray_client_port > 0:
                    ray_kwargs["ray_client_server_port"] = ray_client_port
                ray_params = RayParams(**ray_kwargs)
                node = Node(ray_params, head=True, shutdown_at_exit=False, spawn_reaper=False)
                _write_text_atomic(head_ip_path, ip)
                print(f"mint ray head published IP: {ip}", flush=True)
                health_address = "127.0.0.1:6379"
            else:
                head = _read_head(head_ip_path)
                print(f"mint ray worker connecting to head: {head}", flush=True)
                ray_params = RayParams(
                    gcs_address=head,
                    num_gpus=8,
                    temp_dir=temp_dir,
                    object_spilling_directory=object_spilling_dir,
                )
                node = Node(ray_params, head=False, shutdown_at_exit=False, spawn_reaper=False)
                health_address = head

            while True:
                if not _port_open(health_address):
                    print(f"mint ray {role} lost connectivity to {health_address}; restarting", flush=True)
                    break
                dead = node.dead_processes()
                if dead:
                    print(f"mint ray {role} detected dead ray processes: {dead!r}; restarting", flush=True)
                    break
                time.sleep(CHECK_INTERVAL_S)
        except Exception as exc:
            print(f"mint ray {role} wrapper caught exception: {type(exc).__name__}: {exc}", flush=True)
        finally:
            if node is not None:
                try:
                    node.kill_all_processes(check_alive=False, allow_graceful=False, wait=True)
                except Exception as exc:
                    print(f"mint ray {role} cleanup failed: {type(exc).__name__}: {exc}", flush=True)
            time.sleep(5)


if __name__ == "__main__":
    raise SystemExit(main())
