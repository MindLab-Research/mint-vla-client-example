# Victoria MCP API Key
# 从 Kubernetes Secret monitoring/victorialogs-mcp-api-keys 获取
# 当前可用 client id: ai-client-1
# 联系 @曾一航 或 @NolanHo 获取或轮换密钥
MCP_API_KEY=your_mcp_api_key_here

# Victoria MCP 端点（JSON-RPC 2.0 over Streamable HTTP）
MCP_LOGS_URL=https://otelmcp.macaron.xin/logs/mcp
MCP_METRICS_URL=https://otelmcp.macaron.xin/metrics/mcp
MCP_TRACES_URL=https://otelmcp.macaron.xin/traces/mcp
