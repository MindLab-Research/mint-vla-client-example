  "pipeline": [
    {
      "stage": "kinematic_image_render",
      "inputs": ["raw_lance", "mano_asset_bundle"],
      "producer": "image_producer_repo",
      "evidence": ["render_merge_log"],
      "output": "canonical_lance",
      "semantics": "Per-frame hand/object qpos assignment plus mj_forward and camera rendering; no mj_step."
    },
    {
      "stage": "base_training_fields",
      "inputs": ["canonical_lance"],
      "producer": "image_producer_repo",
      "evidence": ["training_fields_log"],
      "output": "canonical_lance",
      "semantics": "Persisted state is qpos padded to32; persisted actions are measured next-state delta, not B labels; persisted prompt is object-only."
    },
    {
      "stage": "target_column_promotion",
      "inputs": ["canonical_lance"],
      "producer": "target_migration_code",
      "evidence": ["target_migration_report"],
      "output": "canonical_lance",
      "semantics": "Promote hands[].urdf_dof_target without rewriting image fragments; rollback tag pre_mano_target remains at v17."
    },
    {
      "stage": "runtime_training_projection",
      "inputs": ["canonical_lance", "gesture_index", "contact_manifest", "cube1_cube2_norm_stats"],
      "producer": [
        "gesture_contract_code",
        "contact_contract_code",
        "state_contract_code",
        "action_contract_code",
        "wire_projection_code",
        "training_loader_code"
      ],
      "output": "MINT_batch",
      "semantics": "Build gesture prompt, contact/lift 32D state, B-schema horizon10 actions, population norm, and optional transient StateAug."
    },
    {
      "stage": "recorded_target_physics_quality",
      "inputs": ["canonical_lance", "gesture_index", "mano_asset_bundle"],
      "historical_producer": ["physics_generator_archive", "physics_compat_archive"],
      "current_producer": "physics_generator_code",
      "current_scene_contract": ["scene_camera_code", "physics_contract_code"],
      "acceptance_evidence": "physics_generator_equivalence",
      "output": "physics_evidence",
      "semantics": "Frame0 initialization; recorded target execution through MuJoCo dynamics; object is simulation-owned. The maintained generator reproduced historical row850 arrays and metrics bit-for-bit."
    }
  ],
