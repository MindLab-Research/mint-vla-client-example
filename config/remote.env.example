# Connection used from a developer workstation.
VLA_SSH_HOST=115.190.235.210
VLA_SSH_PORT=1634
VLA_SSH_USER=root

# Formal Git checkout of this client repository on the GPU host.
VLA_REMOTE_REPO=/vePFS-Mindverse/user/intern/wenxi/mint-vla-client-example

# MINT is reached from a client process running on the GPU host.
# Ports are not reserved; confirm the assigned server before each run.
MINT_BASE_URL=http://127.0.0.1:30532
MINT_API_KEY=tml-dummy

# Read-only server/model dependencies on PFS for the rank-16 action-LoRA path.
MINT_CODE_ROOT=/vePFS-Mindverse/user/intern/wenxi/mint-state45-28dof
MINT_OPENPI_ROOT=/vePFS-Mindverse/user/intern/wenxi/openpi-state45-28dof
MINT_GRB_ROOT=/vePFS-Mindverse/user/intern/wenxi/mint_env/runtime/gpu_rl
# Optional override for both the client evaluator and a dedicated server.
MINT_PYTHON_BIN=/vePFS-Mindverse/user/intern/wenxi/mint_env/runtime/gpu_rl/host-venv/bin/python
MINT_CPU_ROOT=/vePFS-Mindverse/user/intern/wenxi/mint_env/runtime/cpu
MINT_EXTRA_PYDEPS=/vePFS-Mindverse/user/intern/wenxi/mint_env/extra-pydeps
PI_FINETUNE_ROOT=/vePFS-Mindverse/user/intern/wenxi/pi-finetune

# Shared model assets. The canonical MANO dataset, gesture index, and contact
# sidecar resolve from config/datasets/mano_dataset_release.json. Set
# MINT_LANCE_DATASET only for an explicit non-release experiment override.
OPENPI_DATA_HOME=/vePFS-Mindverse/share/models/openpi
HF_HOME=/vePFS-Mindverse/share/huggingface

# Generated artifacts stay with the formal client checkout and remain Git-ignored.
VLA_CLIENT_RESULTS_ROOT=/vePFS-Mindverse/user/intern/wenxi/mint-vla-client-example/results
VLA_CLIENT_INFERENCE_ROOT=/vePFS-Mindverse/user/intern/wenxi/mint-vla-client-example/results/inference
