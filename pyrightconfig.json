{
  "include": [
    "mint_server",
    "tests",
    "scripts"
  ],
  "exclude": [
    "**/__pycache__",
    ".worktree",
    ".worktrees",
    ".claude/worktrees",
    "**/.venv",
    "**/node_modules",
    "typings"
  ],
  "stubPath": "typings",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["."]
    }
  ]
}
